# Application Environment
# Valid values: local, dev, container, prod, test
# - local: Local development with hot reload
# - dev: Development environment
# - container: Docker containerized environment (docs enabled)
# - prod: Production environment (docs disabled)
# - test: Testing environment
APP_ENV=local

# Logging Configuration
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT_JSON: Set to "true" for structured JSON logs (recommended for production)
# Set to "false" for plain text logs (easier for local development)
LOG_FORMAT_JSON=true

# Database Configuration
POSTGRES_USER=open-projects-hub-admin
POSTGRES_PASSWORD=db-pwd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=open-projects-hub-db

# JWT Configuration
# IMPORTANT: Use a strong, random secret key in production (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# CORS Configuration (comma-separated list for production)
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=false

# Error Tracking (ADR-009) — optional. Leave unset to disable (default in local/test).
# Get a DSN from https://sentry.io (Free Developer plan) for the project's org.
SENTRY_DSN=
