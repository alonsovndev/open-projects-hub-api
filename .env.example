# Application Environment
# Valid values: local, dev, container, prod, test
# - local: Local development with hot reload
# - dev: Development environment
# - container: Docker containerized environment (docs enabled)
# - prod: Production environment (docs disabled)
# - test: Testing environment
APP_ENV=local

# Logging
# Application log level and format (json or text) come from `logging` in
# src/app/config/config_<APP_ENV>.yml. LOG_LEVEL only sets the gunicorn server log level
# in the Docker image (debug, info, warning, error, critical).
LOG_LEVEL=info

# Database Configuration
POSTGRES_USER=open-projects-hub-admin
POSTGRES_PASSWORD=db-pwd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=open-projects-hub-db

# JWT Configuration
# IMPORTANT: Use a strong, random secret key in production (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder below is rejected at startup; replace it.
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Web app origin used in emailed links (verify-email, reset-password).
FRONTEND_BASE_URL=http://localhost:5173

# CORS Configuration (comma-separated list for production)
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=false

# Error Tracking (ADR-009) — optional. Leave unset to disable (default in local/test).
# Get a DSN from https://sentry.io (Free Developer plan) for the project's org.
SENTRY_DSN=

# SMTP Configuration — used to email password reset codes (F-009) and
# sign-up verification codes (F-008). Delivered through Resend's SMTP relay
# (STARTTLS on 587); SMTP_PASSWORD is a Resend API key.
# SMTP_FROM_ADDRESS must be a full address on a domain verified in Resend
# (e.g. no-reply@send.example.com); a bare domain is rejected at startup.
# Failed sends are logged, not silently dropped, and never block the request.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_FROM_ADDRESS=no-reply@send.example.com

# Platform AI (Gemini) — the key the platform spends on a user's free credits.
# Users who want OpenAI/DeepSeek bring their own key through the API instead.
GEMINI_API_KEY=

# User API key encryption (F-010 NFR-010-01) — base64-encoded 32 bytes for AES-256-GCM.
# Required in dev/container/prod; local and test fall back to a public throwaway default.
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing or changing this makes every stored user API key undecryptable — see ADR-018.
API_KEY_ENCRYPTION_KEY=

# First admin (scripts/seed_admin.py, `make seed-admin`). ADMIN_PASSWORD is required there and
# must contain a letter and a digit; it is never printed.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=System Administrator
