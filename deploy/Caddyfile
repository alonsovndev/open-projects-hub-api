{
	admin off
	auto_https off
}

:80 {
	# CloudFront adds this header; a request without it did not come through our distribution.
	@not_from_cloudfront {
		not header X-Origin-Verify {$ORIGIN_VERIFY}
	}
	respond @not_from_cloudfront "Forbidden" 403

	# CloudFront sets CloudFront-Viewer-Address ("ip:port" or "[ipv6]:port"). Without it every
	# user would share the rate-limit key of the CloudFront edge address. The second rule strips
	# the port; the first discards any client-supplied X-Forwarded-For.
	reverse_proxy api:8080 {
		header_up X-Forwarded-For {header.CloudFront-Viewer-Address}
		header_up X-Forwarded-For "^\[?(.+?)\]?:[0-9]+$" "${1}"
	}
}
